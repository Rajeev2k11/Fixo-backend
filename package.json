{
  "name": "fixo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @fixo/api db:generate",
    "db:migrate": "pnpm --filter @fixo/api db:migrate",
    "admin:create": "pnpm --filter @fixo/api admin:create",
    "openapi": "pnpm --filter @fixo/api openapi"
  },
  "prettier": "@fixo/config/prettier.json",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@fixo/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
